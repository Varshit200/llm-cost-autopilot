# LLM Provider API Keys (Optional - if left empty, Autopilot runs in robust simulation/benchmark mode)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Execution Mode: "auto" (calls real APIs if keys set, else simulation), "live" (strict real APIs), "simulation" (offline simulation)
LLM_PROVIDER_MODE=auto

# Application Config
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./data/autopilot.db
LOG_LEVEL=INFO
